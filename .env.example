# Do not commit a real key. Set this only in your local terminal.
OPENAI_API_KEY=your_key_here
# Optional; the CLI default is gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini

# Discord bot: keep all real values local; never commit this file as .env.
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_GUILD_ID=your_server_id
DISCORD_SOURCE_CHANNEL_IDS=general_channel_id,homework_help_channel_id
DISCORD_SUMMARY_CHANNEL_ID=ta_daily_summary_channel_id
DISCORD_AUDIT_CHANNEL_ID=radar_audit_channel_id
# Optional: comma-separated roles allowed to run /daily-radar.
DISCORD_TA_ROLE_IDS=
